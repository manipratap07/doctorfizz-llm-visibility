# Copy to .env. Keep this file out of Git. Never paste secrets into the browser.
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://doctorfizz:CHANGE_ME@localhost:5432/doctorfizz
REDIS_URL=redis://localhost:6379
POSTGRES_PASSWORD=
IP_HASH_SALT=
# Caddy overwrites this header. Do not expose Next directly to the internet.
TRUSTED_IP_HEADER=x-doctorfizz-ip
FREE_ATTEMPTS=5
WINDOW_DAYS=30
IP_DAILY_CAP=15
DOMAIN_DAILY_CAP=10
CACHE_TTL_HOURS=6
RUNS_PER_PROVIDER=1
# Set a real daily budget and conservative cost ceilings from current pricing.
DAILY_BUDGET_USD=
ANALYSIS_COST_CEILING_USD=
EXTRACTOR_MODEL=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=
DEV_BYPASS_TURNSTILE=false
ANTHROPIC_SEARCH_TOOL_VERSION=web_search_20250305
TIER_C_ENABLED=false
TIER_C_TERMS_REVIEWED=false
COPILOT_MODEL_ID=
GOOGLE_AI_MODEL_ID=
HEALTH_CHECK_ENABLED=false
SENTRY_DSN=
ANALYTICS_ID=

OPENAI_API_KEY=
OPENAI_MODEL_ID=
OPENAI_COST_CEILING_USD=
OPENAI_CONCURRENCY=2
OPENAI_ENABLED=true

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=
ANTHROPIC_COST_CEILING_USD=
ANTHROPIC_CONCURRENCY=2
ANTHROPIC_ENABLED=true

GEMINI_API_KEY=
GEMINI_MODEL_ID=
GEMINI_COST_CEILING_USD=
GEMINI_CONCURRENCY=2
GEMINI_ENABLED=true

PERPLEXITY_API_KEY=
PERPLEXITY_MODEL_ID=
PERPLEXITY_COST_CEILING_USD=
PERPLEXITY_CONCURRENCY=2
PERPLEXITY_ENABLED=true

XAI_API_KEY=
XAI_MODEL_ID=
XAI_COST_CEILING_USD=
XAI_CONCURRENCY=2
XAI_ENABLED=true

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_ID=
DEEPSEEK_COST_CEILING_USD=
DEEPSEEK_CONCURRENCY=2
DEEPSEEK_ENABLED=true

MISTRAL_API_KEY=
MISTRAL_MODEL_ID=
MISTRAL_COST_CEILING_USD=
MISTRAL_CONCURRENCY=2
MISTRAL_ENABLED=true

GROQ_API_KEY=
GROQ_MODEL_ID=
GROQ_COST_CEILING_USD=
GROQ_CONCURRENCY=2
GROQ_ENABLED=true

QWEN_API_KEY=
QWEN_MODEL_ID=
QWEN_COST_CEILING_USD=
QWEN_CONCURRENCY=2
QWEN_ENABLED=true

COHERE_API_KEY=
COHERE_MODEL_ID=
COHERE_COST_CEILING_USD=
COHERE_CONCURRENCY=2
COHERE_ENABLED=true

# Qwen requires the correct regional/workspace endpoint for your account.
QWEN_API_URL=
# Optional API endpoint overrides are server-side operator settings.
# OPENAI_API_URL=
# MISTRAL_API_URL=

# Split hosting: set BACKEND_URL only on Vercel; leave empty on the VPS.
BACKEND_URL=
BACKEND_SHARED_SECRET=
# Enable on the VPS when only the Vercel bridge should access APIs.
BACKEND_AUTH_REQUIRED=false
DB_POOL_SIZE=10
