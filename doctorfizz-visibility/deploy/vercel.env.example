# Set these in Vercel -> Project -> Settings -> Environment Variables.
# APP_URL must be the exact origin visitors use, on BOTH Vercel and the VPS.
APP_URL=https://visibility.example.com
BACKEND_URL=https://backend.example.com
BACKEND_SHARED_SECRET=REPLACE_WITH_THE_SAME_RANDOM_SECRET_AS_THE_VPS
BACKEND_AUTH_REQUIRED=false
# Database, Redis and provider credentials belong only on the VPS.
